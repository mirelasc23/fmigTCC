<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import component.CustomInputComponent?>
<?import component.LogoComponent?>
<?import component.BotaoHome?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="controller.Fmig_01Controller">
    
    <fx:define>
        <ToggleGroup fx:id="tgOpInicial" />
    </fx:define>
    
    <children>
        <LogoComponent fx:id="logoHeader" />

        <CustomInputComponent fx:id="acessoRoot" rotulo="Senha do Administrador da Rede:"/>
        <HBox spacing="15.0">
            <children>
                <RadioButton fx:id="tbMigrar" selected="true" text="Migrar regras" toggleGroup="$tgOpInicial" />
                <RadioButton fx:id="tbGerar" text="Gerar regras" toggleGroup="$tgOpInicial" />
            </children>
        </HBox>
        
        <Button fx:id="fmig_02" text="FMIG - Tela_02" onAction="#fmig_02"/>
        
        <BotaoHome />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
