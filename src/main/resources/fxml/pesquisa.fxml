<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:controller="view.PesquisaController" spacing="10.0" 
      xmlns="[http://javafx.com/javafx/23](http://javafx.com/javafx/23)" 
      xmlns:fx="[http://javafx.com/fxml/1](http://javafx.com/fxml/1)">

    <!-- Definição dos ToggleGroups para reutilização nos componentes -->
    <fx:define>
        <ToggleGroup fx:id="tgSo"/>
        <ToggleGroup fx:id="tgLinguagem"/>
    </fx:define>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="20.0"/>
    </padding>

    <children>
        <!-- Título -->
        <Label text="Pesquisa sobre Programação" underline="true"/>

        <!-- Campo Nome -->
        <HBox spacing="10.0">
            <children>
                <Label text="Nome"/>
                <TextField fx:id="txtNome"/>
            </children>
        </HBox>

        <!-- Sistemas Operacionais -->
        <HBox spacing="20.0">
            <children>
                <Label text="Sistema Operacional utilizado"/>
                <ToggleButton fx:id="tbLinux" selected="true" text="Linux" toggleGroup="$tgSo"/>
                <ToggleButton fx:id="tbWindows" text="Windows" toggleGroup="$tgSo"/>
                <ToggleButton fx:id="tbMac" text="Mac" toggleGroup="$tgSo"/>
            </children>
        </HBox>

        <!-- Linguagem de Programação -->
        <HBox spacing="20.0">
            <children>
                <Label text="Linguagem de programação Predileta:"/>
                <RadioButton fx:id="rbJava" selected="true" text="Java" toggleGroup="$tgLinguagem"/>
                <RadioButton fx:id="rbC" text="C" toggleGroup="$tgLinguagem"/>
                <RadioButton fx:id="rbPython" text="Python" toggleGroup="$tgLinguagem"/>
            </children>
        </HBox>

        <!-- Checkboxes -->
        <CheckBox fx:id="chkFrequencia" text="Programa todo dia?"/>
        <CheckBox allowIndeterminate="true" fx:id="chkGosto" indeterminate="true" text="Gosta de programação?"/>

        <!-- Botão de Ação -->
        <Button onAction="#handleSubmeter" text="Submeter pesquisa"/>
    </children>
</VBox>