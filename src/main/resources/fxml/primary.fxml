<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import component.BotaoHome?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PrimaryController">
   <children>
      <Label text="Pesquisa para Programadores" />
      <Button fx:id="researchForProgrammers" text="Switch to Research For Programmers" onAction="#switchToSearch"/>
      
      <Label text="Primary View" />
      <Button fx:id="primaryButton" text="Switch to Secondary View" onAction="#switchToSecondary"/>
      
      <Label text="Terciary View" />
      <Button fx:id="terciaryButton" text="Switch to Terciary View" onAction="#switchToTerciary" />
      
      <Label text="FMIG - Tela_01" />
      <Button fx:id="fmig_01" text="FMIG - Tela_01" onAction="#fmig_01"/>
      
      <Label text="FMIG - Tela_02" />
      <Button fx:id="fmig_02" text="FMIG - Tela_02" onAction="#fmig_02"/>
      
      <BotaoHome />
        
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
